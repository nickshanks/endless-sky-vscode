{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Endless Sky data",
	"patterns": [
		{
			"name": "comment.line.number-sign",
			"match": "#.*"
		},
		{
			"include": "#topLevelKeys"
		},
		{
			"include": "#requireEvent"
		},
		{
			"include": "#requireLabel"
		},
		{
			"include": "#requireKey"
		},
		{
			"name": "keyword.control.endlesssky",
			"match": "(?<=\t)(and|choice|or)$"
		},
		{
			"name": "keyword.control.endlesssky",
			"match": "\\b(random)\\b"
		},
		{
			"include": "#events"
		},
		{
			"include": "#indentedKeys"
		},
		{
			"name": "string.quoted.double.endlesssky",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.endlesssky",
					"match": "(<)(.*?)(>)",
					"captures": {
						"0": {
							"name": "meta.bold.endlesssky"
						},
						"1": {
							"name": "punctuation.definition.bold.endlesssky"
						},
						"2": {
							"name": "markup.bold.endlesssky"
						},
						"3": {
							"name": "punctuation.definition.bold.endlesssky"
						}
					}
				},
				{
					"name": "constant.character.escape.endlesssky",
					"match": "\\\\."
				}
			]
		},
		{
			"name": "string.quoted.backtick.endlesssky",
			"begin": "`",
			"end": "`",
			"patterns": [
				{
					"name": "constant.character.escape.endlesssky",
					"match": "(<)(.*?)(>)",
					"captures": {
						"0": {
							"name": "meta.bold.endlesssky"
						},
						"1": {
							"name": "punctuation.definition.bold.endlesssky"
						},
						"2": {
							"name": "markup.bold.endlesssky"
						},
						"3": {
							"name": "punctuation.definition.bold.endlesssky"
						}
					}
				},
				{
					"name": "constant.character.escape.endlesssky",
					"match": "\\\\."
				}
			]
		},
		{
			"name": "constant.numeric.hex.endlesssky",
			"match": "\\b[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\b"
		},
		{
			"name": "constant.numeric.decimal.endlesssky",
			"match": "(?<=[^a-zA-Z])[-]?(([0-9]*[.][0-9]+)|([0-9]+))"
		},
		{
			"name": "keyword.operator.logical.endlesssky",
			"match": "<=?|>=?"
		},
		{
			"name": "keyword.operator.assignment.compound.endlesssky",
			"match": "\\+=|-="
		},
		{
			"name": "keyword.operator.assignment.endlesssky",
			"match": "="
		},
		{
			"name": "keyword.operator.decrement.endlesssky",
			"match": "--"
		},
		{
			"name": "keyword.operator.increment.endlesssky",
			"match": "\\+\\+"
		},
		{
			"name": "keyword.operator.increment.endlesssky",
			"match": "[\\*/\\+-]"
		}
	],
	"repository": {
		"requireEvent": {
			"match": "(?<=\t)(on|to) (\".+?\"|\\S+)",
			"captures": {
				"1": {
					"name": "keyword.control.endlesssky"
				},
				"2": {
					"name": "support.function.event-handler.endlesssky"
				}
			}
		},
		"requireKey": {
			"match": "(?<=\t)(add|remove) (\".+?\"|\\S+)",
			"captures": {
				"1": {
					"name": "keyword.control.endlesssky"
				},
				"2": {
					"name": "meta.object-literal.key.endlesssky"
				}
			}
		},
		"requireLabel": {
			"match": "(?<=\t)(goto|label|branch) (\".+?\"|\\S+)",
			"captures": {
				"1": {
					"name": "keyword.control.endlesssky"
				},
				"2": {
					"name": "entity.name.label.endlesssky"
				}
			}
		}
	},
	"scopeName": "source.endlesssky"
}
