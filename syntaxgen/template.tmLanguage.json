{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Endless Sky data",
	"patterns": [
		{
			"name": "comment.line.number-sign.endlesssky",
			"match": "#.*"
		},
		{
			"include": "#requireEvent"
		},
		{
			"include": "#requireLabel"
		},
		{
			"include": "#requireKeyValue"
		},
		{
			"include": "#requireKey"
		},
		{
			"include": "#requireValue"
		},
		{
			"name": "keyword.operator.word.endlesssky",
			"match": "(?<=\t)(and|or)$"
		},
		{
			"name": "keyword.control.flow.endlesssky",
			"match": "(?<=\t)(choice)$"
		},
		{
			"name": "keyword.endlesssky",
			"match": "\\b(random)\\b"
		},
		{
			"include": "#events"
		},
		{
			"include": "#topLevelKeys"
		},
		{
			"include": "#indentedKeys"
		},
		{
			"name": "string.quoted.double.endlesssky",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{ "include": "#substitution" },
				{ "include": "#escape" }
			]
		},
		{
			"name": "string.quoted.backtick.endlesssky",
			"begin": "`",
			"end": "`",
			"patterns": [
				{ "include": "#substitution" },
				{ "include": "#escape" }
			]
		},
		{
			"name": "constant.numeric.hex.endlesssky",
			"match": "\\b[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\b"
		},
		{
			"name": "constant.numeric.decimal.endlesssky",
			"match": "(?<=[^a-zA-Z])-?(([0-9]*[.][0-9]+)|([0-9]+))"
		},
		{
			"name": "punctuation.section.parens.begin.bracket.round.endlesssky",
			"match": "[)]"
		},
		{
			"name": "punctuation.section.parens.end.bracket.round.endlesssky",
			"match": "[(]"
		},
		{
			"name": "keyword.operator.comparison.endlesssky",
			"match": "[<>]\\??=?"
		},
		{
			"name": "keyword.operator.assignment.compound.endlesssky",
			"match": "[+-]="
		},
		{
			"name": "keyword.operator.assignment.endlesssky",
			"match": "="
		},
		{
			"name": "keyword.operator.decrement.endlesssky",
			"match": "--"
		},
		{
			"name": "keyword.operator.increment.endlesssky",
			"match": "[+][+]"
		},
		{
			"name": "keyword.operator.arithmetic.endlesssky",
			"match": "[*/+-]"
		}
	],
	"repository": {
		"escape": {
			"name": "constant.character.escape.endlesssky",
			"match": "\\\\."
		},
		"requireEvent": {
			"match": "(?<=\t)(on|to) (\".+?\"|\\S+)",
			"captures": {
				"1": { "name": "keyword.control.endlesssky" },
				"2": { "name": "support.function.event-handler.endlesssky" }
			}
		},
		"requireKey": {
			"match": "(?<=\t)(add|remove) (\".+?\"|\\S+)",
			"captures": {
				"1": { "name": "keyword.control.endlesssky" },
				"2": { "name": "meta.object-literal.key.endlesssky" }
			}
		},
		"requireKeyValue": {
			"match": "(?<=\t)(give|take) (\".+?\"|\\S+) (?=[\"`a-zA-Z])",
			"captures": {
				"1": { "name": "keyword.control.endlesssky" },
				"2": { "name": "meta.object-literal.key.endlesssky" }
			}
		},
		"requireLabel": {
			"match": "(?<=\t)(goto|label|branch) (\".+?\"|\\S+)",
			"captures": {
				"1": { "name": "keyword.control.flow.endlesssky" },
				"2": { "name": "entity.name.label.endlesssky" }
			}
		},
		"requireValue": {
			"match": "(?<=\t)(clear|has|not|set) ([a-z-]+ )?(?=[\"`a-zA-Z])",
			"captures": {
				"1": { "name": "keyword.control.endlesssky" },
				"2": { "name": "meta.object-literal.key.endlesssky" }
			}
		},
		"substitution": {
			"name": "meta.generic.endlesssky",
			"match": "(<)([a-zA-Z0-9 -]*?)(>)",
			"captures": {
				"0": { "name": "meta.bold.endlesssky" },
				"1": { "name": "punctuation.definition.bold.endlesssky" },
				"2": { "name": "markup.bold.endlesssky" },
				"3": { "name": "punctuation.definition.bold.endlesssky" }
			}
		}
	},
	"scopeName": "source.endlesssky"
}
